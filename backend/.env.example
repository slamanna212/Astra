# Copy to backend/.env for local dev (backend/.env is gitignored). Real env vars override this file.

# Required: the Hermes data directory (contains state.db, config.yaml, cron/, skills/, memories/, logs/).
HERMES_HOME=../exampledata/hermes-home

# Optional: Hermes source tree, prepended to sys.path (not needed in the Hermes container image).
ASTRA_HERMES_SRC=../exampledata/hermes-ui-handoff/hermes-agent-src

# Optional: UI-owned state directory (never conversation data). Default: $HERMES_HOME/astra-ui
# ASTRA_DATA_DIR=

# Optional: built frontend to serve with SPA fallback. Default: <repo>/frontend/dist
# ASTRA_STATIC_DIR=

# Required: generate with `uv run python -m astra.hashpw` (single-quote it: it contains `$`).
ASTRA_PASSWORD_HASH='scrypt$32768$8$1$REPLACE_ME$REPLACE_ME'

# Required: >= 32 chars. python -c 'import secrets; print(secrets.token_urlsafe(48))'
ASTRA_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Default true. Set false only for plain-http local dev.
ASTRA_COOKIE_SECURE=false

# Optional: DEBUG / INFO / WARNING. Default INFO.
# ASTRA_LOG_LEVEL=INFO

# Optional: the Files browser's root (browse/preview/download/upload ONLY this tree — never
# HERMES_HOME). Default in production: /workspace. For dev, generate a fixture with
# `uv run python scripts/make_dev_workspace.py` and point this at it:
ASTRA_WORKSPACE_DIR=../exampledata/workspace

# Optional: max upload size in bytes. Default 104857600 (100 MB).
# ASTRA_UPLOAD_MAX_BYTES=104857600
